# ============================================================================
# HUGGING FACE SPACE ENVIRONMENT VARIABLES
# ============================================================================
# Add these secrets in Hugging Face Space → Settings → Secrets and variables
# Note: Models load from public repo (Dedsec-24/Legal-assistance-models), so HF_TOKEN not needed

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of frontend origins allowed to call the backend
# Add your local dev URLs and deployed frontend URL here
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://legal-ai-frontend-page.vercel.app

# Set to true only if you use cookies or browser-based credentials
CORS_ALLOW_CREDENTIALS=false

# Extra allowed request headers (usually keep *)
CORS_ALLOW_HEADERS=*

# ============================================================================
# OPENAI / LLM CONFIGURATION (Optional but Recommended)
# ============================================================================
# For clause prediction and auto-suggestion features

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
CLAUSE_PREDICTION_MODE=manual
MAX_AI_SUGGESTIONS=3

# ============================================================================
# UPLOAD & CLEANUP SETTINGS
# ============================================================================

# How often (in minutes) the background cleanup job runs
UPLOAD_CLEANUP_INTERVAL_MINUTES=5

# How long (in hours) to retain uploaded case files before cleanup deletes them
UPLOAD_RETENTION_HOURS=240

# ============================================================================
# RAG (RETRIEVAL-AUGMENTED GENERATION) SETTINGS
# ============================================================================

# Enable/disable RAG for clause lookup and context retrieval
RAG_ENABLED=true

# Sentence embedding model for RAG semantic search
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Number of top results to retrieve from RAG for each query
RAG_TOP_K=3

# ============================================================================
# MONGODB CONFIGURATION
# ============================================================================
# Store finalized documents in MongoDB GridFS

# MongoDB connection URI (e.g., MongoDB Atlas cluster connection string)
# For local development: mongodb://localhost:27017/
# For cloud: mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/

# MongoDB database name
MONGODB_DATABASE=legal_documents

# ============================================================================
# NOTES
# ============================================================================
# - Do NOT commit actual secrets to this repository
# - Use GitHub Secrets for CI/CD workflows
# - Use Hugging Face Space Secrets for runtime environment variables
# - For local development, create a `.env` file with actual values (git-ignored)
# - All environment variables are optional with sensible defaults
